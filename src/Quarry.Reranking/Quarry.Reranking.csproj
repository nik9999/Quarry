<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Reranking layer for the Quarry RAG stack: the IReranker abstraction, a no-op control, an LLM reranker, Cohere adapter, and the Scrutor-based reranking middleware that transparently decorates an IRetriever. Hosted cross-encoder (ONNX) ships as the separate Quarry.Reranking.Onnx package.</Description>
    <PackageTags>rag;reranking;cross-encoder;relevance;ai;llm;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quarry.Core\Quarry.Core.csproj" />
    <ProjectReference Include="..\Quarry.Retrieval\Quarry.Retrieval.csproj" />
  </ItemGroup>

</Project>
